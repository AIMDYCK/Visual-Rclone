<Window x:Class="RcloneCommanderAdvanced.Views.TrafficMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str_TrafficMonitorTitle}"
        Height="620" Width="900"
        MinHeight="440" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource BgDeepBrush}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabecera: nombre del remoto + estado en vivo -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{DynamicResource Str_TrafficMonitorHeader}"
                           Style="{StaticResource HeaderText}"
                           FontSize="16" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="{Binding RemoteName}"
                               Style="{StaticResource BodyText}"
                               FontWeight="SemiBold"
                               FontSize="13" />
                    <TextBlock Text="  &#183;  "
                               Style="{StaticResource SubHeaderText}" />
                    <TextBlock Text="{Binding StatusText}"
                               Style="{StaticResource SubHeaderText}"
                               FontSize="12"
                               Foreground="{StaticResource SuccessBrush}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <TextBlock Text="{DynamicResource Str_Drive}" Style="{StaticResource SubHeaderText}"
                           FontSize="10" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding DriveLabel}"
                           Style="{StaticResource MonoText}"
                           FontSize="14"
                           HorizontalAlignment="Right"
                           Foreground="{StaticResource AccentBrush}" />
            </StackPanel>
        </Grid>

        <!-- DIAGNOSTICO: barra tecnica que expone el puerto RC consultado,
             el estado del bucle de sondeo, los ciclos completados y el ultimo
             error. Permite ver EN LA UI por que la grafica no recibe datos. -->
        <Border Grid.Row="1"
                Background="#161B22"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="8,5"
                Margin="0,0,0,12">
            <TextBlock Text="{Binding DiagnosticText}"
                       Style="{StaticResource MonoText}"
                       FontSize="10"
                       Foreground="#8B949E"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding DiagnosticText}" />
        </Border>

        <!-- Tarjetas de metricas: actual + pico, subida y bajada -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Bajada actual -->
            <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str_TrafficDownloadNow}"
                               Style="{StaticResource SubHeaderText}" FontSize="10" />
                    <TextBlock Text="{Binding CurrentDownloadText}"
                               Style="{StaticResource MonoText}"
                               FontSize="16"
                               Foreground="#3FB950" />
                </StackPanel>
            </Border>

            <!-- Subida actual -->
            <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Margin="6,0,6,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str_TrafficUploadNow}"
                               Style="{StaticResource SubHeaderText}" FontSize="10" />
                    <TextBlock Text="{Binding CurrentUploadText}"
                               Style="{StaticResource MonoText}"
                               FontSize="16"
                               Foreground="#58A6FF" />
                </StackPanel>
            </Border>

            <!-- Pico de bajada -->
            <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Margin="6,0,6,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str_TrafficDownloadPeak}"
                               Style="{StaticResource SubHeaderText}" FontSize="10" />
                    <TextBlock Text="{Binding PeakDownloadText}"
                               Style="{StaticResource MonoText}"
                               FontSize="16"
                               Foreground="#3FB950" />
                </StackPanel>
            </Border>

            <!-- Pico de subida -->
            <Border Grid.Column="3" Style="{StaticResource PanelBorder}" Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str_TrafficUploadPeak}"
                               Style="{StaticResource SubHeaderText}" FontSize="10" />
                    <TextBlock Text="{Binding PeakUploadText}"
                               Style="{StaticResource MonoText}"
                               FontSize="16"
                               Foreground="#58A6FF" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Grafica nativa: Canvas + Polyline (sin dependencias externas) -->
        <Border Grid.Row="3"
                Background="#0D1117"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="4">
            <Grid x:Name="ChartHost"
                  SizeChanged="OnChartHostSizeChanged"
                  ClipToBounds="True">

                <!-- Rejilla de fondo (lineas horizontales de referencia) -->
                <Canvas x:Name="GridCanvas" IsHitTestVisible="False">
                    <Line X1="0" Y1="0" X2="0" Y2="0" Stroke="#21262D" StrokeThickness="1"
                          x:Name="GridLine1" />
                    <Line X1="0" Y1="0" X2="0" Y2="0" Stroke="#21262D" StrokeThickness="1"
                          x:Name="GridLine2" />
                    <Line X1="0" Y1="0" X2="0" Y2="0" Stroke="#21262D" StrokeThickness="1"
                          x:Name="GridLine3" />
                    <Line X1="0" Y1="0" X2="0" Y2="0" Stroke="#21262D" StrokeThickness="1"
                          x:Name="GridLine4" />
                </Canvas>

                <!-- Serie de bajada (verde) -->
                <Canvas IsHitTestVisible="False">
                    <Polyline Points="{Binding DownloadPoints}"
                              Stroke="#3FB950"
                              StrokeThickness="2"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                </Canvas>

                <!-- Serie de subida (azul) -->
                <Canvas IsHitTestVisible="False">
                    <Polyline Points="{Binding UploadPoints}"
                              Stroke="#58A6FF"
                              StrokeThickness="2"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                </Canvas>

                <!-- Escala maxima del eje Y (auto-ajustable) -->
                <TextBlock Text="{Binding AxisMaxText}"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Margin="8,6,0,0"
                           Style="{StaticResource SubHeaderText}"
                           FontSize="10"
                           IsHitTestVisible="False" />

                <!-- Mensaje cuando aun no hay datos suficientes -->
                <TextBlock Text="{DynamicResource Str_TrafficNoData}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="12"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasData}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- Pie: leyenda + contador de muestras -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Rectangle Width="14" Height="3" Fill="#3FB950" VerticalAlignment="Center"
                           RadiusX="1.5" RadiusY="1.5" />
                <TextBlock Text="{DynamicResource Str_TrafficDownload}"
                           Style="{StaticResource SubHeaderText}"
                           FontSize="11" Margin="6,0,18,0" VerticalAlignment="Center" />

                <Rectangle Width="14" Height="3" Fill="#58A6FF" VerticalAlignment="Center"
                           RadiusX="1.5" RadiusY="1.5" />
                <TextBlock Text="{DynamicResource Str_TrafficUpload}"
                           Style="{StaticResource SubHeaderText}"
                           FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="{DynamicResource Str_TrafficTransfers}"
                           Style="{StaticResource SubHeaderText}"
                           FontSize="11" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ActiveTransfers}"
                           Style="{StaticResource MonoText}"
                           FontSize="12" Margin="6,0,18,0" VerticalAlignment="Center" />

                <TextBlock Text="{DynamicResource Str_TrafficSamples}"
                           Style="{StaticResource SubHeaderText}"
                           FontSize="11" VerticalAlignment="Center" />
                <TextBlock Text="{Binding SampleCount}"
                           Style="{StaticResource MonoText}"
                           FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
