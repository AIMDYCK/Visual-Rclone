<Window x:Class="RcloneCommanderAdvanced.Views.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str_PasswordTitle}"
        Height="360" Width="500"
        MinHeight="340" MinWidth="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BgDeepBrush}">

    <Grid Margin="32,28,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="{DynamicResource Str_AppBrand}" Style="{StaticResource HeaderText}" />
            <TextBlock Text="{DynamicResource Str_AppBrandSuffix}"
                       Foreground="{StaticResource AccentBrush}"
                       FontSize="13" FontWeight="Bold" Margin="0,2,0,0" />
        </StackPanel>

        <!-- Explicacion -->
        <Border Grid.Row="1" Margin="0,0,0,18"
                Padding="14,12"
                CornerRadius="6"
                Background="#1A2332"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="{DynamicResource Str_PasswordHeader}"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="14" FontWeight="Bold" />
                <TextBlock Text="{DynamicResource Str_PasswordDescription}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <!-- Campo de contrasena -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="{DynamicResource Str_PasswordLabel}"
                       Style="{StaticResource SubHeaderText}"
                       FontSize="11"
                       Margin="0,0,0,6" />
            <PasswordBox x:Name="PasswordInput"
                         Style="{StaticResource DarkPasswordBox}"
                         PasswordChanged="PasswordInput_PasswordChanged"
                         KeyDown="PasswordInput_KeyDown" />
        </StackPanel>

        <!-- Mensaje de error -->
        <TextBlock Grid.Row="3"
                   Text="{Binding ErrorMessage}"
                   Foreground="{StaticResource DangerBrush}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0"
                   Visibility="{Binding ErrorMessage,
                                Converter={StaticResource StringToVisibility}}" />

        <!-- Nota de seguridad -->
        <TextBlock Grid.Row="4"
                   Text="{DynamicResource Str_PasswordSecurityNote}"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="11"
                   TextWrapping="Wrap"
                   VerticalAlignment="Top"
                   Margin="0,14,0,0" />

        <!-- Acciones -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{DynamicResource Str_PasswordUnlock}"
                    Style="{StaticResource PrimaryButton}"
                    Margin="0,0,10,0"
                    IsDefault="True"
                    Click="Unlock_Click" />
            <Button Content="{DynamicResource Str_PasswordExit}"
                    Style="{StaticResource BaseButton}"
                    IsCancel="True"
                    Click="Exit_Click" />
        </StackPanel>
    </Grid>
</Window>
