<Window x:Class="RcloneCommanderAdvanced.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ConfirmDialogTitle}"
        Width="520"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        SnapsToDevicePixels="True">

    <!--
        Dialogo de confirmacion generico con la estetica oscura de la aplicacion.
        Sustituye al MessageBox nativo para respetar el tema visual y el sistema
        multilenguaje. El titulo, el mensaje y las etiquetas de los botones se
        inyectan desde el llamador (ya localizados) via las propiedades
        HeaderText / MessageText / ConfirmText / CancelText.
    -->
    <Border Background="{StaticResource BgPanelBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18"
                              ShadowDepth="0"
                              Opacity="0.55"
                              Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Cabecera: barra de acento (roja para acciones destructivas) + titulo -->
            <Border Grid.Row="0"
                    Background="{StaticResource BgElevatedBrush}"
                    CornerRadius="10,10,0,0"
                    Padding="18,14">
                <StackPanel Orientation="Horizontal">
                    <Border Width="4"
                            Height="20"
                            CornerRadius="2"
                            Background="{StaticResource DangerBrush}"
                            Margin="0,0,12,0" />
                    <TextBlock x:Name="HeaderLabel"
                               Text="{Binding HeaderText, RelativeSource={RelativeSource AncestorType=Window}}"
                               Style="{StaticResource HeaderText}"
                               FontSize="14"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Mensaje -->
            <TextBlock Grid.Row="1"
                       Text="{Binding MessageText, RelativeSource={RelativeSource AncestorType=Window}}"
                       Style="{StaticResource BodyText}"
                       TextWrapping="Wrap"
                       LineHeight="20"
                       Margin="22,20,22,22" />

            <!-- Botones -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="22,0,22,20">
                <Button x:Name="CancelButton"
                        Content="{Binding CancelText, RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource GhostButton}"
                        MinWidth="110"
                        Margin="0,0,10,0"
                        Click="Cancel_Click" />

                <Button x:Name="ConfirmButton"
                        Content="{Binding ConfirmText, RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource DangerButton}"
                        MinWidth="150"
                        Click="Confirm_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
