<Window x:Class="RcloneCommanderAdvanced.Views.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str_LogViewerTitle}"
        Height="560" Width="860"
        MinHeight="380" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource BgDeepBrush}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabecera: nombre del remoto + estado -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{DynamicResource Str_LogViewerHeader}"
                           Style="{StaticResource HeaderText}"
                           FontSize="16" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="{Binding Name}"
                               Style="{StaticResource BodyText}"
                               FontWeight="SemiBold"
                               FontSize="13" />
                    <TextBlock Text="  &#183;  "
                               Style="{StaticResource SubHeaderText}" />
                    <TextBlock Text="{Binding StatusText}"
                               Style="{StaticResource SubHeaderText}"
                               FontSize="12"
                               Foreground="{Binding StatusColor}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <TextBlock Text="{DynamicResource Str_Drive}" Style="{StaticResource SubHeaderText}"
                           FontSize="10" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding DriveLabel}"
                           Style="{StaticResource MonoText}"
                           FontSize="14"
                           HorizontalAlignment="Right"
                           Foreground="{StaticResource AccentBrush}" />
            </StackPanel>
        </Grid>

        <!-- Consola: lista de lineas de log en tiempo real -->
        <Border Grid.Row="1"
                Background="#0D1117"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <ListBox ItemsSource="{Binding LogLines}"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="#C9D1D9"
                     FontFamily="Consolas"
                     FontSize="12"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="8,2" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="#C9D1D9" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>

        <!-- Pie: acciones -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Style="{StaticResource HintText}"
                       VerticalAlignment="Center"
                       Text="{DynamicResource Str_LogViewerHint}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="{DynamicResource Str_LogViewerClear}"
                        Style="{StaticResource IconActionButton}"
                        Margin="0,0,8,0"
                        ToolTip="{DynamicResource Str_LogViewerClearTooltip}"
                        Command="{Binding ClearLogsCommand}" />

                <Button Content="{DynamicResource Str_Close}"
                        Style="{StaticResource IconActionButton}"
                        Click="OnCloseClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
