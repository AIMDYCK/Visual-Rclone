<Window x:Class="RcloneCommanderAdvanced.Views.ConfigManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sel="clr-namespace:RcloneCommanderAdvanced.Selectors"
        xmlns:helpers="clr-namespace:RcloneCommanderAdvanced.Helpers"
        Title="{DynamicResource Str_ConfigManagerTitle}"
        Height="720" Width="760"
        MinHeight="620" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource BgDeepBrush}">

    <Window.Resources>
        <!--
            Plantillas del formulario dinamico del paso 3. El
            ProviderOptionTemplateSelector elige una u otra en funcion del
            tipo de opcion que publica el esquema de rclone.
        -->
        <DataTemplate x:Key="ProviderOptionChoiceTemplate">
            <StackPanel Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Name}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock Text=" *"
                               Foreground="{StaticResource DangerBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsRequired, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="&#xE946;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="12"
                               Foreground="{StaticResource AccentBrush}"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               ToolTip="{Binding Help}"
                               Visibility="{Binding HasHelp, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <!--
                    BUGFIX (OAuth client_secret): antes se enlazaba con
                    SelectedValue/SelectedValuePath, lo que SOLO capturaba un
                    valor presente en Examples. Si el usuario tecleaba un valor
                    libre (o el campo era un secreto con ejemplos), Value quedaba
                    vacio y rclone abortaba con "client_secret is missing".
                    Ahora el ComboBox es editable y se enlaza por Text, de modo
                    que tanto elegir un ejemplo como escribir libremente
                    actualizan Value.
                -->
                <ComboBox ItemsSource="{Binding Examples}"
                          IsEditable="True"
                          Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Style="{StaticResource DarkComboBox}"
                          Margin="0,6,0,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display, Mode=OneWay}"
                                       Foreground="{StaticResource ComboForegroundBrush}"
                                       TextWrapping="Wrap"
                                       MaxWidth="520" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ProviderOptionBooleanTemplate">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <CheckBox IsChecked="{Binding BoolValue, Mode=TwoWay}"
                          VerticalAlignment="Center" />
                <TextBlock Text="{Binding Name}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="12"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center" />
                <TextBlock Text="&#xE946;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="12"
                           Foreground="{StaticResource AccentBrush}"
                           Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           ToolTip="{Binding Help}"
                           Visibility="{Binding HasHelp, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ProviderOptionSecretTemplate">
            <StackPanel Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Name}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock Text=" *"
                               Foreground="{StaticResource DangerBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsRequired, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="&#xE946;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="12"
                               Foreground="{StaticResource AccentBrush}"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               ToolTip="{Binding Help}"
                               Visibility="{Binding HasHelp, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <!--
                    FIX CRITICO (client_secret is missing):
                    PasswordBox.Password NO es una DependencyProperty bindable
                    por diseno, por lo que el binding estandar {Binding Value}
                    no propagaba el texto escrito al ViewModel y rclone recibia
                    client_secret vacio.

                    Se usa un TextBox estandar (OPCION A) con binding TwoWay y
                    UpdateSourceTrigger=PropertyChanged para garantizar que el
                    valor viaje SIEMPRE al ViewModel antes de ensamblar los
                    argumentos. Se prioriza la funcionalidad sobre el enmascarado.
                -->
                <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource DarkTextBox}"
                         Margin="0,6,0,0" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ProviderOptionTextTemplate">
            <StackPanel Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Name}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock Text=" *"
                               Foreground="{StaticResource DangerBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsRequired, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="&#xE946;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="12"
                               Foreground="{StaticResource AccentBrush}"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               ToolTip="{Binding Help}"
                               Visibility="{Binding HasHelp, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource DarkTextBox}"
                         Margin="0,6,0,0" />
            </StackPanel>
        </DataTemplate>

        <sel:ProviderOptionTemplateSelector x:Key="ProviderOptionSelector"
                                            ChoiceTemplate="{StaticResource ProviderOptionChoiceTemplate}"
                                            BooleanTemplate="{StaticResource ProviderOptionBooleanTemplate}"
                                            SecretTemplate="{StaticResource ProviderOptionSecretTemplate}"
                                            TextTemplate="{StaticResource ProviderOptionTextTemplate}" />
    </Window.Resources>

    <Grid Margin="28,22,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== Encabezado ==================== -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="{DynamicResource Str_ConfigManagerTitle}"
                       Style="{StaticResource HeaderText}" />
            <TextBlock Text="{DynamicResource Str_ConfigManagerSubtitle}"
                       Style="{StaticResource SubHeaderText}"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0" />
            <TextBlock Text="{Binding ConfigPath}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="11"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,6,0,0" />
        </StackPanel>

        <!-- ============== Barra de acciones / pasos ============== -->
        <Grid Grid.Row="1" Margin="0,16,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Titulo del paso del asistente (visible solo en el wizard) -->
            <TextBlock Grid.Column="0"
                       Text="{Binding WizardStepTitle}"
                       Style="{StaticResource SubHeaderText}"
                       VerticalAlignment="Center"
                       Visibility="{Binding IsWizardOpen, Converter={StaticResource BoolToVisibility}}" />

            <Button Grid.Column="1"
                    Content="{DynamicResource Str_AddRemote}"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding StartAddRemoteCommand}"
                    Visibility="{Binding IsListVisible, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <!-- ==================== Contenido ==================== -->
        <Grid Grid.Row="2">

            <!-- ========== Lista de remotos (tarjetas) ========== -->
            <Grid Visibility="{Binding IsListVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditOpen}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Estado vacio -->
                <Border Grid.Row="0"
                        Padding="20"
                        CornerRadius="8"
                        Background="{StaticResource BgElevatedBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="&#xE7BA;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="30"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Str_NoRemotesConfigured}"
                                   Style="{StaticResource SubHeaderText}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- Tarjetas -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="0,8,0,0">
                    <ItemsControl ItemsSource="{Binding Remotes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10"
                                        Padding="16,14"
                                        CornerRadius="8"
                                        Background="{StaticResource BgElevatedBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Icono del proveedor -->
                                        <Border Grid.Column="0"
                                                Width="42" Height="42"
                                                CornerRadius="21"
                                                Background="{StaticResource BgDeepBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Glyph}"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="18"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Nombre + tipo -->
                                        <StackPanel Grid.Column="1"
                                                    Margin="14,0,14,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,3,0,0">
                                                <Run Text="{Binding ProviderName, Mode=OneWay}" />
                                                <Run Text="  ·  " />
                                                <Run Text="{Binding Type, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Acciones -->
                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <!--
                                                Sin Width fijo: MinWidth + Padding permiten que
                                                el boton crezca con traducciones largas (p.ej.
                                                "ELIMINAR" o "SUPPRIMER") sin truncar el texto.
                                            -->
                                            <Button Content="{DynamicResource Str_EditRemote}"
                                                    Style="{StaticResource GhostButton}"
                                                    Height="30"
                                                    MinWidth="100"
                                                    Padding="15,5"
                                                    Margin="0,0,10,0"
                                                    Command="{Binding DataContext.EditRemoteCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />

                                            <Button Content="{DynamicResource Str_DeleteRemote}"
                                                    Style="{StaticResource DangerButton}"
                                                    Height="30"
                                                    MinWidth="100"
                                                    Padding="15,5"
                                                    Command="{Binding DataContext.DeleteRemoteCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- ========== Panel de edicion de un remoto existente ========== -->
            <Border Visibility="{Binding IsEditOpen, Converter={StaticResource BoolToVisibility}}"
                    Padding="22"
                    CornerRadius="8"
                    Background="{StaticResource BgElevatedBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>

                        <!-- Cabecera -->
                        <StackPanel Orientation="Horizontal">
                            <Border Width="42" Height="42"
                                    CornerRadius="21"
                                    Background="{StaticResource BgDeepBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding EditGlyph}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="18"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Str_EditRemoteTitle}"
                                           Style="{StaticResource SubHeaderText}" />
                                <TextBlock Text="{Binding EditProviderName}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="{DynamicResource Str_EditRemoteSubtitle}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0" />

                        <!-- Nombre (editable: permite renombrar el remoto) -->
                        <TextBlock Text="{DynamicResource Str_EditName}"
                                   Style="{StaticResource SubHeaderText}"
                                   Margin="0,18,0,0" />
                        <TextBox Text="{Binding EditRemoteName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBox}"
                                 Margin="0,8,0,0" />
                        <TextBlock Text="{DynamicResource Str_EditNameHint}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />

                        <!-- Tipo de backend (solo lectura) -->
                        <TextBlock Text="{DynamicResource Str_EditType}"
                                   Style="{StaticResource SubHeaderText}"
                                   Margin="0,14,0,0" />
                        <TextBox Text="{Binding EditType, Mode=OneWay}"
                                 Style="{StaticResource DarkTextBox}"
                                 IsReadOnly="True"
                                 Opacity="0.7"
                                 Margin="0,8,0,0" />

                        <!-- ===== Boton de re-autenticacion OAuth ===== -->
                        <Border Visibility="{Binding CanReauthenticate, Converter={StaticResource BoolToVisibility}}"
                                Margin="0,18,0,0"
                                Padding="14"
                                CornerRadius="6"
                                Background="{StaticResource BgDeepBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Str_Reauthenticate}"
                                               Style="{StaticResource SubHeaderText}" />
                                    <TextBlock Text="{DynamicResource Str_ReauthenticateHint}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding ReauthStatusMessage}"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0"
                                               Visibility="{Binding ReauthStatusMessage, Converter={StaticResource StringToVisibility}}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="{DynamicResource Str_Reauthenticate}"
                                        Style="{StaticResource SuccessButton}"
                                        Height="34"
                                        Padding="16,0"
                                        Margin="14,0,0,0"
                                        VerticalAlignment="Center"
                                        IsEnabled="{Binding IsReauthenticating, Converter={StaticResource InverseBool}}"
                                        Command="{Binding ReauthenticateCommand}" />
                            </Grid>
                        </Border>

                        <!-- ===== Credenciales OAuth propias (client_id / client_secret) ===== -->
                        <!--
                            Solo visible para backends que declaran client_id o
                            client_secret en su esquema (drive, onedrive, dropbox...).
                            Se usa TextBox estandar (NO PasswordBox): PasswordBox.Password
                            no es una DependencyProperty bindable y provocaba que el
                            valor no llegara al ViewModel (bug "client_secret is missing").
                        -->
                        <StackPanel Visibility="{Binding CanEditOAuthCredentials, Converter={StaticResource BoolToVisibility}}"
                                    Margin="0,18,0,0">
                            <TextBlock Text="{DynamicResource Str_OAuthCredentials}"
                                       Style="{StaticResource SubHeaderText}" />
                            <TextBlock Text="{DynamicResource Str_OAuthCredentialsHint}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />

                            <!--
                                Aviso de reautenticacion: explica al usuario POR QUE
                                se abrira el navegador al guardar cambios en las
                                credenciales OAuth. Se usa un Border con fondo tenue
                                y WarningBrush para denotar advertencia sin romper el
                                tema oscuro de la app.
                            -->
                            <Border Background="#22F5A623"
                                    BorderBrush="{StaticResource WarningBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,10"
                                    Margin="0,12,0,0">
                                <TextBlock Text="{DynamicResource Str_OAuthReauthWarning}"
                                           Foreground="{StaticResource WarningBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap" />
                            </Border>

                            <!-- Client ID -->
                            <TextBlock Text="{DynamicResource Str_EditClientIdLabel}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="0,12,0,0" />
                            <TextBox Text="{Binding EditClientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DarkTextBox}"
                                     Margin="0,6,0,0" />

                            <!-- Client Secret -->
                            <TextBlock Text="{DynamicResource Str_EditClientSecretLabel}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="0,12,0,0" />
                            <TextBox Text="{Binding EditClientSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DarkTextBox}"
                                     Margin="0,6,0,0" />
                            <TextBlock Text="{DynamicResource Str_ClientSecretHint}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                        </StackPanel>

                        <!-- ===== Opciones avanzadas (diccionario dinamico) ===== -->
                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Str_AdvancedOptions}"
                                           Style="{StaticResource SubHeaderText}" />
                                <TextBlock Text="{DynamicResource Str_AdvancedOptionsHint}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0" />
                                <!-- El texto llega ya formateado desde el ViewModel:
                                     la plantilla localizada contiene un {0} que WPF no
                                     sustituye al enlazarla con DynamicResource dentro de
                                     un Run, por lo que se resolvia literalmente. -->
                                <TextBlock Text="{Binding HiddenSensitiveMessage}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding HasHiddenSensitive, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="{DynamicResource Str_AddOption}"
                                    Style="{StaticResource GhostButton}"
                                    Height="32"
                                    Padding="14,0"
                                    VerticalAlignment="Center"
                                    Command="{Binding AddOptionCommand}" />
                        </Grid>

                        <!-- Cabecera de columnas -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{DynamicResource Str_Key}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Margin="4,0,0,0" />
                            <TextBlock Grid.Column="1"
                                       Text="{DynamicResource Str_Value}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Margin="4,0,0,0" />
                        </Grid>

                        <!-- Filas clave/valor -->
                        <ItemsControl ItemsSource="{Binding EditOptions}"
                                      Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Las claves sensibles (token, etc.) se ocultan por completo. -->
                                    <Grid Margin="0,0,0,6"
                                          Visibility="{Binding IsSensitive, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="240" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Clave + icono de ayuda contextual -->
                                        <Grid Grid.Column="0" Margin="0,0,8,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     IsReadOnly="{Binding IsReadOnly}">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource DarkTextBox}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                                                <Setter Property="Opacity" Value="0.6" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                            <TextBlock Grid.Column="1"
                                                       Text="&#xE946;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="13"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="6,0,0,0"
                                                       ToolTip="{Binding Help}"
                                                       Visibility="{Binding HasHelp, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>

                                        <!-- Valor: ComboBox editable si el esquema define opciones, si no TextBox.
                                             Se usa Text (no SelectedValue) para que un valor guardado que
                                             no figure entre los ejemplos no provoque una excepcion de
                                             sincronizacion en el Selector de WPF. -->
                                        <Grid Grid.Column="1" Margin="0,0,8,0">
                                            <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource DarkTextBox}"
                                                     Visibility="{Binding HasExamples, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                            <!-- El dropdown se ensancha hasta 520px para que las
                                                 descripciones largas de rclone (p.ej. scope) se
                                                 lean completas; el TextBlock envuelve el texto en
                                                 varias lineas en lugar de recortarlo.
                                                 Nota: WPF no expone MaxDropDownWidth (es de
                                                 WinForms); el ancho del popup lo determina el
                                                 contenido, por eso se fija MaxWidth en el item. -->
                                            <ComboBox ItemsSource="{Binding Examples}"
                                                      IsEditable="True"
                                                      Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Visibility="{Binding HasExamples, Converter={StaticResource BoolToVisibility}}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Display}"
                                                                   ToolTip="{Binding Help}"
                                                                   TextWrapping="Wrap"
                                                                   MaxWidth="520" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </Grid>

                                        <Button Grid.Column="2"
                                                Content="&#xE74D;"
                                                FontFamily="Segoe MDL2 Assets"
                                                Style="{StaticResource GhostButton}"
                                                Height="30"
                                                Width="32"
                                                Padding="0"
                                                ToolTip="{DynamicResource Str_RemoveOption}"
                                                IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBool}}"
                                                Command="{Binding DataContext.RemoveOptionCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Validacion -->
                        <TextBlock Text="{Binding EditValidationMessage}"
                                   Foreground="#E53E3E"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"
                                   Visibility="{Binding EditValidationMessage, Converter={StaticResource StringToVisibility}}" />

                        <!-- Acciones -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,22,0,0">
                            <Button Content="{DynamicResource Str_Cancel}"
                                    Style="{StaticResource GhostButton}"
                                    Height="35"
                                    Width="100"
                                    Margin="0,0,10,0"
                                    Command="{Binding CancelRemoteEditCommand}" />

                            <Button Content="{DynamicResource Str_SaveChanges}"
                                    Style="{StaticResource SuccessButton}"
                                    Height="35"
                                    Width="150"
                                    Command="{Binding SaveRemoteEditCommand}" />
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ========== Asistente de 4 pasos ========== -->
            <Border Visibility="{Binding IsWizardOpen, Converter={StaticResource BoolToVisibility}}"
                    Padding="22"
                    CornerRadius="8"
                    Background="{StaticResource BgElevatedBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>

                        <!-- Paso 1: nombre -->
                        <StackPanel Visibility="{Binding WizardStep, Converter={StaticResource StepToVisibility}, ConverterParameter=1}">
                            <TextBlock Text="{DynamicResource Str_RemoteNameLabel}"
                                       Style="{StaticResource SubHeaderText}" />
                            <TextBox Text="{Binding RemoteName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DarkTextBox}"
                                     Margin="0,8,0,0" />
                            <TextBlock Text="{DynamicResource Str_RemoteNameHint}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                            <!--
                                Validacion en tiempo real: el mensaje se pinta en
                                rojo y el boton NEXT se bloquea mientras el nombre
                                sea invalido o ya exista (HasNameError).
                            -->
                            <TextBlock Text="{Binding ValidationMessage}"
                                       Foreground="{StaticResource DangerBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"
                                       Visibility="{Binding HasNameError, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>

                        <!-- Paso 2: proveedor -->
                        <StackPanel Visibility="{Binding WizardStep, Converter={StaticResource StepToVisibility}, ConverterParameter=2}">
                            <TextBlock Text="{DynamicResource Str_ProviderLabel}"
                                       Style="{StaticResource SubHeaderText}"
                                       Margin="0,0,0,10" />
                            <ListBox ItemsSource="{Binding Providers}"
                                     SelectedItem="{Binding SelectedProvider, Mode=TwoWay}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Margin" Value="0,0,8,8" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <!--
                                                        Tarjetas compactas: 124x80 (antes 150x96, ~17% menos)
                                                        para que quepan mas proveedores por fila sin
                                                        romper el layout responsivo del WrapPanel.
                                                    -->
                                                    <Border x:Name="CardBorder"
                                                            Width="124" Height="80"
                                                            Padding="8"
                                                            CornerRadius="8"
                                                            Background="{StaticResource BgDeepBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1">
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Glyph}"
                                                                       FontFamily="Segoe MDL2 Assets"
                                                                       FontSize="18"
                                                                       Foreground="{StaticResource AccentBrush}"
                                                                       HorizontalAlignment="Center" />
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                                       FontSize="11"
                                                                       TextAlignment="Center"
                                                                       TextWrapping="Wrap"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Margin="0,6,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="#3182CE" />
                                                            <Setter TargetName="CardBorder" Property="BorderThickness" Value="2" />
                                                            <Setter TargetName="CardBorder" Property="Background" Value="#2D3748" />
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="#3182CE" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <ContentPresenter />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Desplegable de backends adicionales: solo visible
                                 cuando se elige la tarjeta "Otros / Avanzado". -->
                            <StackPanel Margin="0,6,0,0"
                                        Visibility="{Binding IsAdvancedProviderSelected, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{DynamicResource Str_AdvancedProviderLabel}"
                                           Style="{StaticResource SubHeaderText}"
                                           Margin="0,0,0,8" />
                                <!--
                                    FIX DataBinding: se usa un ItemTemplate explicito en
                                    lugar de DisplayMemberPath. El ControlTemplate de
                                    DarkComboBoxItem usa un ContentPresenter sin
                                    ContentTemplate, por lo que DisplayMemberPath no se
                                    aplicaba al desplegable y mostraba el ToString() del
                                    objeto (RcloneCommanderAdvanced.Models.RemoteProvider).
                                    El ItemTemplate fija SelectionBoxItemTemplate y se
                                    respeta tanto en el desplegable como en la caja cerrada.
                                -->
                                <ComboBox ItemsSource="{Binding AdvancedProviders}"
                                          SelectedItem="{Binding SelectedAdvancedProvider, Mode=TwoWay}"
                                          Style="{StaticResource DarkComboBox}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayName, Mode=OneWay}"
                                                           Foreground="{StaticResource ComboForegroundBrush}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Type, Mode=OneWay}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="10"
                                                           Margin="8,0,0,0"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="{DynamicResource Str_AdvancedProviderHint}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <!--
                            Paso 3: configuracion dinamica.

                            El formulario NO esta hardcodeado: se genera a partir
                            del esquema que rclone publica en "rclone config
                            providers". Cada opcion del backend se renderiza con
                            el control adecuado (ComboBox / CheckBox / PasswordBox
                            / TextBox) mediante ProviderOptionTemplateSelector.
                        -->
                        <StackPanel Visibility="{Binding WizardStep, Converter={StaticResource StepToVisibility}, ConverterParameter=3}">
                            <TextBlock Text="{DynamicResource Str_ProviderOptionsLabel}"
                                       Style="{StaticResource SubHeaderText}"
                                       Margin="0,0,0,10" />

                            <!-- Cargando el esquema del backend -->
                            <StackPanel Visibility="{Binding IsLoadingOptions, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{DynamicResource Str_LoadingOptions}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                                <ProgressBar IsIndeterminate="True"
                                             Height="4"
                                             Margin="0,10,0,0" />
                            </StackPanel>

                            <!-- Formulario generado dinamicamente -->
                            <ItemsControl ItemsSource="{Binding WizardOptions}"
                                          ItemTemplateSelector="{StaticResource ProviderOptionSelector}"
                                          Visibility="{Binding IsLoadingOptions, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />

                            <!-- Backend sin opciones configurables (local, union...) -->
                            <Border Visibility="{Binding HasNoWizardOptions, Converter={StaticResource BoolToVisibility}}"
                                    Background="{StaticResource BgDeepBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12">
                                <TextBlock Text="{DynamicResource Str_NoCredentialsNeeded}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                            </Border>

                            <!-- Ayuda sobre credenciales propias (Client ID / Secret) -->
                            <TextBlock Text="{DynamicResource Str_CredentialsHint}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,14,0,0"
                                       Visibility="{Binding ProviderRequiresOAuth, Converter={StaticResource BoolToVisibility}}" />

                            <TextBlock Margin="0,8,0,0"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding ProviderRequiresOAuth, Converter={StaticResource BoolToVisibility}}">
                                <Hyperlink Command="{Binding OpenProviderDocsCommand}"
                                           Foreground="{StaticResource AccentBrush}"
                                           TextDecorations="Underline">
                                    <Run Text="{DynamicResource Str_HowToGetClientId}" />
                                </Hyperlink>
                            </TextBlock>

                            <!-- Formulario especifico de cifrado (crypt) -->
                            <StackPanel Visibility="{Binding ProviderRequiresCrypt, Converter={StaticResource BoolToVisibility}}">
                                <Border Background="{StaticResource BgDeepBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12"
                                        Margin="0,4,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Str_CryptRemoteLabel}"
                                                   Style="{StaticResource SubHeaderText}"
                                                   Margin="0,0,0,6" />
                                        <TextBox Style="{StaticResource DarkTextBox}"
                                                 Text="{Binding CryptRemote, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{DynamicResource Str_CryptRemoteTooltip}" />

                                        <TextBlock Text="{DynamicResource Str_CryptPasswordLabel}"
                                                   Style="{StaticResource SubHeaderText}"
                                                   Margin="0,14,0,6" />
                                        <TextBox Style="{StaticResource DarkTextBox}"
                                                 Text="{Binding CryptPassword, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{DynamicResource Str_CryptPasswordTooltip}" />

                                        <TextBlock Text="{DynamicResource Str_CryptFilenameEncryptionLabel}"
                                                   Style="{StaticResource SubHeaderText}"
                                                   Margin="0,14,0,6" />
                                        <ComboBox Style="{StaticResource DarkComboBox}"
                                                  ItemsSource="{Binding CryptFilenameEncryptionModes}"
                                                  SelectedItem="{Binding CryptFilenameEncryption}"
                                                  ToolTip="{DynamicResource Str_CryptFilenameEncryptionTooltip}" />

                                        <TextBlock Text="{DynamicResource Str_CryptHint}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Margin="0,14,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Paso 4: autenticar / probar y guardar -->
                        <StackPanel Visibility="{Binding WizardStep, Converter={StaticResource StepToVisibility}, ConverterParameter=4}">
                            <!-- Pista dependiente del flujo (OAuth vs directo) -->
                            <TextBlock Text="{Binding AuthenticateHintText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,10" />

                            <TextBlock Text="{Binding BusyMessage}"
                                       Style="{StaticResource SubHeaderText}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                            <ProgressBar IsIndeterminate="True"
                                         Height="4"
                                         Margin="0,12,0,12"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                            <Grid Margin="0,4,0,0">
                                <TextBox Text="{Binding OperationLog, Mode=OneWay}"
                                         Style="{StaticResource DarkTextBox}"
                                         FontFamily="Consolas"
                                         FontSize="11"
                                         Height="140"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         IsReadOnly="True" />

                                <!-- Estado vacio: se muestra mientras no haya log -->
                                <TextBlock Text="{DynamicResource Str_AuthenticateEmptyState}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           FontStyle="Italic"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="24,0"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding OperationLog, Converter={StaticResource StringToVisibility}, ConverterParameter=Inverse}" />
                            </Grid>
                        </StackPanel>

                        <!-- Resultado -->
                        <TextBlock Text="{Binding ResultMessage}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,14,0,0"
                                   Visibility="{Binding ResultMessage, Converter={StaticResource StringToVisibility}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ==================== Pie de pagina ==================== -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Grupo izquierdo: accion de aborto (Cancelar) -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                <Button Content="{DynamicResource Str_Cancel}"
                        Width="100" Height="35"
                        Background="#1A202C"
                        Foreground="#E53E3E"
                        BorderBrush="#C53030"
                        BorderThickness="1"
                        Command="{Binding CancelWizardCommand}"
                        Visibility="{Binding IsWizardOpen, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <!-- Grupo derecho: navegacion del asistente (Atras / Siguiente) -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <!--
                    Boton principal del paso 4: el texto cambia segun el flujo
                    del backend (OAuth -> autenticar en navegador; directo ->
                    probar conexion y guardar).
                -->
                <Button Content="{Binding AuthenticateButtonText}"
                        Style="{StaticResource SuccessButton}"
                        Command="{Binding AuthenticateCommand}"
                        Margin="0,0,8,0"
                        Visibility="{Binding WizardStep, Converter={StaticResource StepToVisibility}, ConverterParameter=4}" />
                <Button Content="{DynamicResource Str_Back}"
                        Width="100" Height="35"
                        Background="#2D3748"
                        Foreground="#E2E8F0"
                        BorderBrush="#4A5568"
                        BorderThickness="1"
                        Command="{Binding PreviousStepCommand}"
                        Margin="0,0,8,0"
                        Visibility="{Binding IsWizardOpen, Converter={StaticResource BoolToVisibility}}" />
                <!--
                    NEXT se bloquea en el paso 1 mientras el nombre sea invalido
                    o ya exista (HasNameError), y se oculta en el paso 4 donde
                    el boton principal toma el relevo.
                -->
                <Button Content="{DynamicResource Str_Next}"
                        Width="100" Height="35"
                        Background="#3182CE"
                        Foreground="White"
                        BorderBrush="#3182CE"
                        BorderThickness="1"
                        Command="{Binding NextStepCommand}"
                        Visibility="{Binding IsWizardOpen, Converter={StaticResource BoolToVisibility}}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="IsEnabled" Value="True" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasNameError}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                    <Setter Property="Opacity" Value="0.5" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
