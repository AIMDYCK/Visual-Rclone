<Window x:Class="RcloneCommanderAdvanced.Views.LockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str_LockTitle}"
        Height="620" Width="480"
        MinHeight="580" MinWidth="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{StaticResource BgDeepBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="36,28,36,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Encabezado -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,8,0,0">
                <Border Width="72" Height="72" CornerRadius="36"
                        Background="{StaticResource BgElevatedBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Center">
                    <TextBlock Text="&#xE72E;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="30"
                               Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <TextBlock Text="{DynamicResource Str_LockPanelLocked}"
                           Style="{StaticResource HeaderText}"
                           HorizontalAlignment="Center"
                           Margin="0,18,0,0" />

                <TextBlock Text="{DynamicResource Str_LockEnterPin}"
                           Style="{StaticResource SubHeaderText}"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0" />
            </StackPanel>

            <!-- Frase de recordatorio (solo si existe) -->
            <Border Grid.Row="1" Margin="0,18,0,0"
                    Padding="12,10"
                    CornerRadius="6"
                    Background="#12233A"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1"
                    Visibility="{Binding ReminderPhrase, Converter={StaticResource StringToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str_LockYourReminder}"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="11" FontWeight="Bold" />
                    <TextBlock Text="{Binding ReminderPhrase}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="13" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Formulario -->
            <StackPanel Grid.Row="2" Margin="0,20,0,0">
                <PasswordBox x:Name="PinBox"
                             Style="{StaticResource DarkPasswordBox}"
                             FontSize="18"
                             Padding="14,12"
                             PasswordChanged="OnPinChanged"
                             KeyDown="OnPinKeyDown" />

                <!-- Mensaje de error destacado: fondo rojo tenue + borde. -->
                <Border Margin="0,14,0,0"
                        Padding="10,8"
                        CornerRadius="6"
                        Background="#2D1418"
                        BorderBrush="{StaticResource DangerBrush}"
                        BorderThickness="1"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource DangerBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center" />
                </Border>

                <!-- Confiar en este dispositivo -->
                <Border Margin="0,18,0,0"
                        Padding="12,10"
                        CornerRadius="6"
                        Background="{StaticResource BgPanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <CheckBox Content="{DynamicResource Str_LockTrustDevice}"
                                  Style="{StaticResource DarkCheckBox}"
                                  FontWeight="SemiBold"
                                  IsChecked="{Binding TrustThisDevice}" />

                        <TextBlock Style="{StaticResource SubHeaderText}"
                                   TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="{DynamicResource Str_LockTrustDeviceDescription}" />

                        <!--
                            Selector de duracion de la confianza.
                            - Se usa un ItemTemplate explicito (en lugar de
                              DisplayMemberPath) porque la plantilla personalizada
                              de DarkComboBox pinta el elemento seleccionado con
                              SelectionBoxItemTemplate; un ItemTemplate explicito
                              garantiza que se muestre "Label" y no el nombre
                              completo del tipo (namespace + clase).
                            - Solo es visible cuando el usuario marca
                              "Confiar en este dispositivo".
                        -->
                        <ComboBox Margin="0,10,0,0"
                                  Style="{StaticResource DarkComboBox}"
                                  ItemsSource="{Binding TrustDurations}"
                                  SelectedItem="{Binding SelectedTrustDuration}"
                                  Visibility="{Binding IsTrustDeviceChecked,
                                               Converter={StaticResource BoolToVisibility}}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}"
                                               Foreground="#E2E8F0"
                                               FontSize="12"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Acciones -->
            <StackPanel Grid.Row="3" Margin="0,20,0,0">
                <Button Content="{DynamicResource Str_LockUnlock}"
                        Style="{StaticResource PrimaryButton}"
                        Height="44"
                        Command="{Binding UnlockCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />

                <TextBlock Style="{StaticResource SubHeaderText}"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,14,0,0"
                           Text="{DynamicResource Str_LockMountsRemain}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
