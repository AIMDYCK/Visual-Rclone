<Window x:Class="RcloneCommanderAdvanced.Views.FirstRunSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str_FirstRunTitle}"
        Height="640" Width="620"
        MinHeight="600" MinWidth="580"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BgDeepBrush}">

    <Grid Margin="32,26,32,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{DynamicResource Str_AppBrand}" Style="{StaticResource HeaderText}" />
            <TextBlock Text="{DynamicResource Str_AppBrandSuffix}"
                       Foreground="{StaticResource AccentBrush}"
                       FontSize="13" FontWeight="Bold" Margin="0,2,0,0" />
            <TextBlock Text="{DynamicResource Str_FirstRunSubtitle}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0" />
        </StackPanel>

        <!-- Estado de componentes -->
        <StackPanel Grid.Row="1" Margin="0,0,0,14">

            <!-- rclone -->
            <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Indicador de estado -->
                    <Ellipse Grid.Column="0"
                             Width="12" Height="12"
                             VerticalAlignment="Center"
                             Margin="0,0,12,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRcloneInstalled}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="{DynamicResource Str_DependencyRcloneName}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding RcloneStatusText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   Margin="0,3,0,0" />
                    </StackPanel>

                    <Button Grid.Column="2"
                            Content="{DynamicResource Str_QuickInstall}"
                            Style="{StaticResource PrimaryButton}"
                            VerticalAlignment="Center"
                            Command="{Binding QuickInstallCommand}" />
                </Grid>
            </Border>

            <!-- WinFsp -->
            <Border Style="{StaticResource PanelBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Ellipse Grid.Column="0"
                             Width="12" Height="12"
                             VerticalAlignment="Center"
                             Margin="0,0,12,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWinFspInstalled}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="{DynamicResource Str_DependencyWinFspName}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding WinFspStatusText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   Margin="0,3,0,0" />
                    </StackPanel>

                    <Button Grid.Column="2"
                            Content="{DynamicResource Str_DownloadWinFsp}"
                            Style="{StaticResource BaseButton}"
                            VerticalAlignment="Center"
                            Command="{Binding OpenWinFspDownloadCommand}" />
                </Grid>
            </Border>
        </StackPanel>

        <!-- Progreso de la operacion -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <ProgressBar Height="8"
                         Minimum="0" Maximum="100"
                         Value="{Binding ProgressValue}"
                         Foreground="{StaticResource AccentBrush}"
                         Background="#1A1A1A"
                         BorderThickness="0" />
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="11"
                       Margin="0,6,0,0" />
        </StackPanel>

        <!-- Mensaje de estado / error -->
        <Border Grid.Row="3" Margin="0,0,0,10"
                Padding="12,10"
                CornerRadius="6"
                Background="#2D1A10"
                BorderBrush="{StaticResource WarningBrush}"
                BorderThickness="1"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{StaticResource WarningBrush}"
                       FontSize="12"
                       TextWrapping="Wrap" />
        </Border>

        <!-- Nota informativa -->
        <TextBlock Grid.Row="4"
                   Text="{DynamicResource Str_FirstRunFooter}"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="11"
                   TextWrapping="Wrap"
                   VerticalAlignment="Top"
                   Margin="0,4,0,0" />

        <!-- Acciones -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{DynamicResource Str_RetryDetection}"
                    Style="{StaticResource BaseButton}"
                    Margin="0,0,10,0"
                    Command="{Binding RetryDetectionCommand}" />
            <Button Content="{DynamicResource Str_Continue}"
                    Style="{StaticResource PrimaryButton}"
                    Margin="0,0,10,0"
                    Command="{Binding CompleteCommand}" />
            <Button Content="{DynamicResource Str_Exit}"
                    Style="{StaticResource BaseButton}"
                    Command="{Binding CancelCommand}" />
        </StackPanel>
    </Grid>
</Window>
