<Window x:Class="RcloneCommanderAdvanced.Views.DependencyWarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str_DependencyTitle}"
        Height="480" Width="560"
        MinHeight="440" MinWidth="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BgDeepBrush}">

    <Grid Margin="32,28,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="{DynamicResource Str_AppBrand}" Style="{StaticResource HeaderText}" />
            <TextBlock Text="{DynamicResource Str_AppBrandSuffix}"
                       Foreground="{StaticResource AccentBrush}"
                       FontSize="13" FontWeight="Bold" Margin="0,2,0,0" />
        </StackPanel>

        <!-- Aviso principal -->
        <Border Grid.Row="1" Margin="0,0,0,18"
                Padding="14,12"
                CornerRadius="6"
                Background="#2D1A10"
                BorderBrush="{StaticResource WarningBrush}"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="{DynamicResource Str_DependencyHeader}"
                           Foreground="{StaticResource WarningBrush}"
                           FontSize="14" FontWeight="Bold" />
                <TextBlock Text="{Binding Summary}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <!-- Detalle de cada dependencia -->
        <StackPanel Grid.Row="2">

            <!-- rclone -->
            <Border Style="{StaticResource PanelBorder}"
                    Margin="0,0,0,12"
                    Visibility="{Binding IsRcloneMissing, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="{DynamicResource Str_DependencyRcloneName}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource Str_DependencyRcloneDescription}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="{DynamicResource Str_DependencyDownloadRclone}"
                            Style="{StaticResource PrimaryButton}"
                            VerticalAlignment="Center"
                            Command="{Binding OpenRcloneDownloadCommand}" />
                </Grid>
            </Border>

            <!-- WinFsp -->
            <Border Style="{StaticResource PanelBorder}"
                    Margin="0,0,0,12"
                    Visibility="{Binding IsWinFspMissing, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="{DynamicResource Str_DependencyWinFspName}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource Str_DependencyWinFspDescription}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="{DynamicResource Str_DependencyDownloadWinFsp}"
                            Style="{StaticResource PrimaryButton}"
                            VerticalAlignment="Center"
                            Command="{Binding OpenWinFspDownloadCommand}" />
                </Grid>
            </Border>
        </StackPanel>

        <!-- Nota inferior -->
        <TextBlock Grid.Row="3"
                   Text="{DynamicResource Str_DependencyFooter}"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="11"
                   TextWrapping="Wrap"
                   VerticalAlignment="Top"
                   Margin="0,4,0,0" />

        <!-- Acciones -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{DynamicResource Str_DependencyRetry}"
                    Style="{StaticResource BaseButton}"
                    Margin="0,0,10,0"
                    Click="Retry_Click" />
            <Button Content="{DynamicResource Str_DependencyExit}"
                    Style="{StaticResource BaseButton}"
                    Click="Exit_Click" />
        </StackPanel>
    </Grid>
</Window>
