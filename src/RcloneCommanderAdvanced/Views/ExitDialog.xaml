<Window x:Class="RcloneCommanderAdvanced.Views.ExitDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ExitDialogTitle}"
        Width="520"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        SnapsToDevicePixels="True">

    <!-- Tarjeta oscura con borde sutil, coherente con el resto del panel. -->
    <Border Background="{StaticResource BgPanelBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18"
                              ShadowDepth="0"
                              Opacity="0.55"
                              Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Cabecera: barra de acento + titulo -->
            <Border Grid.Row="0"
                    Background="{StaticResource BgElevatedBrush}"
                    CornerRadius="10,10,0,0"
                    Padding="18,14">
                <StackPanel Orientation="Horizontal">
                    <Border Width="4"
                            Height="20"
                            CornerRadius="2"
                            Background="{StaticResource AccentBrush}"
                            Margin="0,0,12,0" />
                    <TextBlock Text="{DynamicResource ExitDialogHeader}"
                               Style="{StaticResource HeaderText}"
                               FontSize="14"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Mensaje -->
            <TextBlock Grid.Row="1"
                       Text="{DynamicResource ExitDialogMessage}"
                       Style="{StaticResource BodyText}"
                       TextWrapping="Wrap"
                       LineHeight="20"
                       Margin="22,20,22,22" />

            <!-- Botones -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="22,0,22,20">
                <Button x:Name="CancelButton"
                        Content="{DynamicResource ExitBtnCancel}"
                        Style="{StaticResource GhostButton}"
                        MinWidth="96"
                        Margin="0,0,10,0"
                        Click="Cancel_Click" />

                <Button x:Name="BackgroundButton"
                        Content="{DynamicResource ExitBtnBackground}"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="150"
                        Margin="0,0,10,0"
                        Click="Background_Click" />

                <Button x:Name="ExitButton"
                        Content="{DynamicResource ExitBtnClose}"
                        Style="{StaticResource DangerButton}"
                        MinWidth="150"
                        Click="Exit_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
