    <!-- SSD maintenance -->
    <s:String x:Key="Str_SsdMaintenance">SSD MAINTENANCE</s:String>
    <s:String x:Key="Str_VfsCache">rclone VFS cache</s:String>
    <s:String x:Key="Str_VfsOptimization">VFS performance optimization</s:String>
    <s:String x:Key="Str_VfsCacheMode">Cache mode (--vfs-cache-mode)</s:String>
    <s:String x:Key="Str_VfsCacheModeTooltip">Controls how rclone caches files. "full" is recommended on Windows for best compatibility.</s:String>
    <s:String x:Key="Str_VfsCacheModeHelp">Defines HOW files are stored on the local disk. "off" caches nothing (slower and less compatible); "writes" only stores what you write; "full" downloads and stores everything before use, making it the most stable and recommended option on Windows.</s:String>
    <s:String x:Key="Str_BufferSize">Read buffer size (--buffer-size)</s:String>
    <s:String x:Key="Str_BufferSizeTooltip">Memory buffer used per file transfer. Larger values improve throughput on fast links.</s:String>
    <s:String x:Key="Str_BufferSizeHelp">This is the amount of RAM rclone reserves to read each file. A higher value speeds up video playback and large copies, but uses more memory. If you have little RAM use 16M or 32M; if you have plenty, use 64M or 128M.</s:String>
    <s:String x:Key="Str_DirCacheTime">Directory cache time (--dir-cache-time)</s:String>
    <s:String x:Key="Str_DirCacheTimeTooltip">How long directory listings are cached. Longer values reduce API calls.</s:String>
    <s:String x:Key="Str_DirCacheTimeHelp">How long rclone remembers the list of folders and files before asking the server again. A high value (for example 72h) makes browsing much faster and reduces API usage; a low value makes changes appear sooner but generates more traffic.</s:String>
    <s:String x:Key="Str_VfsHint">Leave a field empty to use the value defined by the selected profile.</s:String>
    <s:String x:Key="Str_CryptRemoteLabel">Underlying remote and path</s:String>
    <s:String x:Key="Str_CryptRemoteTooltip">Remote and folder to encrypt, e.g. MyDrive:/SecureFolder</s:String>
    <s:String x:Key="Str_CryptPasswordLabel">Encryption password</s:String>
    <s:String x:Key="Str_CryptPasswordTooltip">Password used to encrypt and decrypt the files. Keep it safe: without it the data cannot be recovered.</s:String>
    <s:String x:Key="Str_CryptFilenameEncryptionLabel">Filename obfuscation</s:String>
    <s:String x:Key="Str_CryptFilenameEncryptionTooltip">How file names are hidden: standard, obfuscate or off.</s:String>
    <s:String x:Key="Str_CryptHint">The encrypted remote wraps an existing remote. Mount it like any other drive to read and write transparently.</s:String>
    <s:String x:Key="Str_CryptRemoteRequired">Please enter the underlying remote and path (e.g. MyDrive:/SecureFolder).</s:String>
    <s:String x:Key="Str_CryptPasswordRequired">Please enter the encryption password.</s:String>
