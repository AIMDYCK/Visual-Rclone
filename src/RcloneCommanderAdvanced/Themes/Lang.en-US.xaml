    <!-- Mount profiles -->
    <s:String x:Key="Str_ProfileSafeReadName">Safe Read (Anti-Ransomware)</s:String>
    <s:String x:Key="Str_ProfileSafeReadDescription">Mounts the drive as read-only with no disk cache. Ideal for critical data: no local process can modify or encrypt the remote files.</s:String>
    <s:String x:Key="Str_ProfileSafeReadPros">Immune to ransomware and accidental deletions; zero writes to the SSD; minimal RAM usage.</s:String>
    <s:String x:Key="Str_ProfileSafeReadCons">Does not allow creating, editing or deleting files; browsing may be slower because it does not cache to disk.</s:String>

    <s:String x:Key="Str_ProfileHighPerformanceName">High Performance (5GB SSD Cache)</s:String>
    <s:String x:Key="Str_ProfileHighPerformanceDescription">Full VFS cache on disk up to 5 GB with 64 MB read chunks. Maximum browsing and streaming speed, at the cost of SSD writes.</s:String>
    <s:String x:Key="Str_ProfileHighPerformancePros">Maximum browsing and streaming speed; supports read and write; open files stay consistent.</s:String>
    <s:String x:Key="Str_ProfileHighPerformanceCons">Writes cache to the SSD (wear); uses up to 5 GB of disk; higher RAM usage.</s:String>

    <s:String x:Key="Str_ProfileBulkTransferName">Bulk Transfer (RAM Buffer)</s:String>
    <s:String x:Key="Str_ProfileBulkTransferDescription">Write cache in RAM with a 128 MB buffer. Designed for bulk copies without wearing the SSD, with directory refresh every hour.</s:String>
    <s:String x:Key="Str_ProfileBulkTransferPros">Does not wear the SSD (RAM cache); excellent for bulk copies; lower write latency.</s:String>
    <s:String x:Key="Str_ProfileBulkTransferCons">Buffered data is lost if the process closes abruptly; higher RAM usage; slow directory refresh.</s:String>

    <s:String x:Key="Str_ProfileCustomName">Custom</s:String>
