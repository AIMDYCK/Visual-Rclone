    <!-- Mount profiles -->
    <s:String x:Key="Str_ProfileSafeReadName">Sicheres Lesen (Anti-Ransomware)</s:String>
    <s:String x:Key="Str_ProfileSafeReadDescription">Bindet das Laufwerk schreibgeschützt und ohne Festplatten-Cache ein. Ideal für kritische Daten: Kein lokaler Prozess kann die Remote-Dateien ändern oder verschlüsseln.</s:String>
    <s:String x:Key="Str_ProfileSafeReadPros">Immun gegen Ransomware und versehentliches Löschen; keine Schreibzugriffe auf die SSD; minimaler RAM-Verbrauch.</s:String>
    <s:String x:Key="Str_ProfileSafeReadCons">Erlaubt kein Erstellen, Bearbeiten oder Löschen von Dateien; die Navigation kann langsamer sein, da kein Festplatten-Cache verwendet wird.</s:String>

    <s:String x:Key="Str_ProfileHighPerformanceName">Hohe Leistung (5 GB SSD-Cache)</s:String>
    <s:String x:Key="Str_ProfileHighPerformanceDescription">Vollständiger VFS-Cache auf der Festplatte bis zu 5 GB mit 64 MB Leseblöcken. Maximale Navigations- und Streaming-Geschwindigkeit auf Kosten von SSD-Schreibzugriffen.</s:String>
    <s:String x:Key="Str_ProfileHighPerformancePros">Maximale Navigations- und Streaming-Geschwindigkeit; unterstützt Lesen und Schreiben; geöffnete Dateien bleiben konsistent.</s:String>
    <s:String x:Key="Str_ProfileHighPerformanceCons">Schreibt Cache auf die SSD (Verschleiß); belegt bis zu 5 GB Speicherplatz; höherer RAM-Verbrauch.</s:String>

    <s:String x:Key="Str_ProfileBulkTransferName">Massentransfer (RAM-Puffer)</s:String>
    <s:String x:Key="Str_ProfileBulkTransferDescription">Schreib-Cache im RAM mit einem 128 MB-Puffer. Für Massenkopien ohne SSD-Verschleiß konzipiert, mit stündlicher Verzeichnisaktualisierung.</s:String>
    <s:String x:Key="Str_ProfileBulkTransferPros">Kein SSD-Verschleiß (RAM-Cache); hervorragend für Massenkopien; geringere Schreiblatenz.</s:String>
    <s:String x:Key="Str_ProfileBulkTransferCons">Gepufferte Daten gehen verloren, wenn der Prozess abrupt beendet wird; höherer RAM-Verbrauch; langsame Verzeichnisaktualisierung.</s:String>

    <s:String x:Key="Str_ProfileCustomName">Benutzerdefiniert</s:String>
    <s:String x:Key="Str_ProfileCustomDescription">Benutzerdefiniertes Profil mit benutzerdefinierten Argumenten.</s:String>
    <s:String x:Key="Str_ProfileCustomPros">Volle Kontrolle über die rclone-Argumente.</s:String>
    <s:String x:Key="Str_ProfileCustomCons">Erfordert fortgeschrittene Kenntnisse der rclone-Optionen.</s:String>

