<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <!-- Version de la aplicacion. Se refleja en las propiedades del EXE
         (Archivo > Propiedades > Detalles) y en AssemblyInformationalVersion.
         v1.0.0: primera release publica de Visual Rclone. -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>Visual Rclone</Product>
    <AssemblyTitle>Visual Rclone</AssemblyTitle>
    <Company>Visual Rclone</Company>
    <InformationalVersion>1.0.0 - Visual Rclone</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Icono de la aplicacion: empaquetado como recurso WPF para poder
         referenciarlo con pack://application:,,,/Assets/app.ico -->
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="System.Management" Version="10.0.12" />
  </ItemGroup>

</Project>
