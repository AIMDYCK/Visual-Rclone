<Application x:Class="RcloneCommanderAdvanced.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:RcloneCommanderAdvanced.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkTheme.xaml" />
                <!--
                    Diccionario base de idioma (ingles). Se fusiona de forma
                    estatica para garantizar que SIEMPRE exista un conjunto de
                    textos disponible antes de que se cargue cualquier vista.
                    El LocalizationService anade despues el idioma activo por
                    encima; si ese paso fallara, la UI seguiria mostrando el
                    idioma por defecto en lugar de quedarse vacia.
                -->
                <ResourceDictionary Source="Themes/Lang.en-US.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Convierte una clave de traduccion en su texto localizado. -->
            <conv:LocalizedKeyConverter x:Key="LocalizedKey" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
